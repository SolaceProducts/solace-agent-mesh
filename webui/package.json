{
    "name": "solace-agent-mesh-webui",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "description": "Solace Agent Mesh WebUI frontend",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "prepare": "sh -c '[ -f ../scripts/setup-hooks.sh ] && sh ../scripts/setup-hooks.sh || exit 0'",
        "dev": "vite --config vite.config.ts",
        "build": "tsc -p tsconfig.json --noEmit && vite build --config vite.config.ts",
        "format": "prettier --write src",
        "format:check": "prettier --check src",
        "lint": "prettier --check src && eslint . && node scripts/check-agents-index.js",
        "precommit": "tsc -b && lint-staged",
        "preview": "vite preview --config vite.config.ts",
        "storybook": "storybook dev -p 6007 --config-dir src/.storybook",
        "test": "vitest --config vitest.config.ts --project=unit",
        "test:storybook": "vitest --config vitest.config.ts --project=storybook",
        "ci": "CI=true vitest --config vitest.config.ts --project=unit --project=storybook"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@hookform/resolvers": "7.0.7",
        "@microsoft/teams-js": "2.59.0",
        "@openfeature/core": "1.12.0",
        "@openfeature/react-sdk": "1.4.1",
        "@openfeature/web-sdk": "1.10.0",
        "@radix-ui/react-accordion": "1.3.1",
        "@radix-ui/react-avatar": "1.3.1",
        "@radix-ui/react-dialog": "1.3.1",
        "@radix-ui/react-dropdown-menu": "2.2.1",
        "@radix-ui/react-label": "2.1.17",
        "@radix-ui/react-popover": "1.3.1",
        "@radix-ui/react-select": "2.4.1",
        "@radix-ui/react-separator": "1.2.0",
        "@radix-ui/react-slot": "1.5.0",
        "@radix-ui/react-tabs": "1.2.1",
        "@radix-ui/react-tooltip": "1.4.1",
        "@silurus/ooxml": "0.90.1",
        "@stepperize/react": "8.0.1",
        "@tanstack/react-query": "5.108.0",
        "@tanstack/react-table": "9.3.1",
        "@use-gesture/react": "10.3.1",
        "@xyflow/react": "12.12.1",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "dompurify": "3.4.18",
        "html-react-parser": "6.1.10",
        "js-yaml": "4.3.2",
        "json-edit-react": "2.0.5",
        "jszip": "3.10.2",
        "lucide-react": "1.76.0",
        "marked": "18.2.1",
        "mermaid": "12.3.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-error-boundary": "6.1.6",
        "react-hook-form": "7.92.0",
        "react-intersection-observer": "11.0.1",
        "react-pdf": "9.2.1",
        "react-resizable-panels": "4.24.1",
        "react-router-dom": "7.18.6",
        "recharts": "3.11.0",
        "tailwind-merge": "3.7.0",
        "uuid": "14.0.3",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@a2a-js/sdk": "0.3.14",
        "@eslint/js": "10.0.1",
        "@storybook/addon-vitest": "10.6.7",
        "@storybook/react": "10.6.7",
        "@storybook/react-vite": "10.6.7",
        "@tailwindcss/vite": "4.3.5",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/js-yaml": "4.0.9",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "@vitest/browser-playwright": "5.1.1",
        "@vitest/coverage-v8": "5.1.1",
        "eslint": "10.15.0",
        "eslint-plugin-import-x": "4.18.1",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.8",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "globals": "17.14.0",
        "jsdom": "31.0.1",
        "lint-staged": "17.6.1",
        "msw": "3.0.7",
        "msw-storybook-addon": "3.0.3",
        "playwright": "1.65.1",
        "prettier": "3.10.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "storybook": "10.6.7",
        "tailwindcss": "4.3.5",
        "tw-animate-css": "1.4.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.73.0",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    },
    "overrides": {
        "cross-spawn": "7.0.6",
        "minimatch": "10.2.5",
        "lodash": "4.18.1",
        "lodash-es": "4.18.1",
        "flatted": "3.4.2",
        "storybook": {
            "esbuild": "0.28.2"
        },
        "mermaid": {
            "katex": "0.18.10"
        }
    },
    "msw": {
        "workerDirectory": [
            "src/.storybook/public"
        ]
    }
}
